rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seed collections are read-only from the client; writes happen through the seed command.
    match /foods/{foodId} { allow read: if true; allow write: if false; }
    match /recipes/{recipeId} { allow read: if true; allow write: if false; }
    match /nutritionGoals/{goalId} { allow read: if true; allow write: if false; }
    match /mealTemplates/{templateId} { allow read: if true; allow write: if false; }
    match /groceryItems/{itemId} { allow read: if true; allow write: if false; }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /foodLogs/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /mealPlans/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /groceryLists/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /workoutCompletions/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /weightLogs/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Coach history is accessed through the authorized server route only.
      match /coachMessages/{documentId} {
        allow read, write: if false;
      }
    }
  }
}
